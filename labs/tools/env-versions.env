# Pinned course environment. The only place to change a version.
# Read by tools/setup_env.sh and tools/check_env.sh. Update setup.md in the same commit.
# The Rust toolchain is RUST in tools/formatter-versions.env (rustfmt ships with it).

# CUDA toolkit inside WSL (apt package cuda-toolkit-12-6). Windows driver 566.x supports CUDA <= 12.7.
CUDA=12.6
# PyTorch wheel built for that CUDA; it pulls in the matching Triton.
TORCH=2.14.1
TORCH_INDEX=https://download.pytorch.org/whl/cu126
TRITON=3.8.0

# Python packages for tests, baselines and plots (lab0 onwards).
NUMPY=2.5.3
MATPLOTLIB=3.11.2
PYTEST=9.1.1

# Hugging Face tooling for lab4/lab5 (reference logits, model download).
TRANSFORMERS=5.18.0
SAFETENSORS=0.8.0
HF_HUB=1.33.0
