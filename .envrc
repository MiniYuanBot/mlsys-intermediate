# Optional direnv integration for POSIX shells.
mlsys_environment="${MLSYS_VENV:-}"
if [[ -z "$mlsys_environment" && -d "$PWD/labs/.venv" ]]; then
    mlsys_environment="$PWD/labs/.venv"
elif [[ -z "$mlsys_environment" && -d "$HOME/venvs/mlsys" ]]; then
    mlsys_environment="$HOME/venvs/mlsys"
fi
if [[ -n "$mlsys_environment" && -d "$mlsys_environment" ]]; then
    export VIRTUAL_ENV="$mlsys_environment"
    if [[ -d "$VIRTUAL_ENV/Scripts" ]]; then
        PATH_add "$VIRTUAL_ENV/Scripts"
    else
        PATH_add "$VIRTUAL_ENV/bin"
    fi
fi
unset mlsys_environment
